# Kaggle (kg.sh)
COMP=gemma-4-developer-agent
KAGGLE_USER=ton_username

# Gemma 4 pour l'agent (agent/run.py), API compatible OpenAI
# Clé Google AI Studio : https://aistudio.google.com/apikey  (ou OpenRouter : https://openrouter.ai/keys)
GEMMA_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemma-4-26b-a4b-it
# Ollama local : LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=gemma4:e4b  (GEMMA_API_KEY vide)

# Fine-tuning (training/train_qlora.py)
BASE_MODEL=google/gemma-4-e4b-it
